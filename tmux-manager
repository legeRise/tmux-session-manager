#!/usr/bin/env python3
"""List, export, and restore tmux workspaces."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("PyYAML is required. Install it with: pip install pyyaml")


HELP_EPILOG = """
examples:
  tmux-manager ls
  tmux-manager export
  tmux-manager restore
  tmux-manager restore my-project
  tmux-manager restore --help

workspaces are saved under:
  $XDG_DATA_HOME/tmux-manager/workspaces
  (usually ~/.local/share/tmux-manager/workspaces)

override with TMUX_MANAGER_HOME if you want a different folder.
"""


def tmux(args: list[str], check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["tmux", *args],
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def tmux_out(args: list[str]) -> str:
    result = tmux(args)
    return result.stdout.rstrip("\n")


def die(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    sys.exit(code)


def data_home() -> Path:
    override = os.environ.get("TMUX_MANAGER_HOME")
    if override:
        return Path(override).expanduser()
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return Path(xdg) / "tmux-manager"
    return Path.home() / ".local/share/tmux-manager"


def workspaces_dir() -> Path:
    path = data_home() / "workspaces"
    path.mkdir(parents=True, exist_ok=True)
    return path


def safe_filename(name: str) -> str:
    cleaned = re.sub(r"[^\w.-]+", "-", name.strip())
    return cleaned.strip("-._") or "workspace"


def pane_command(pane_pid: str) -> str:
    child = subprocess.run(
        ["pgrep", "-P", pane_pid, "-n"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    child_pid = child.stdout.strip()
    if child.returncode != 0 or not child_pid:
        return ""
    args = subprocess.run(
        ["ps", "-p", child_pid, "-o", "args="],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return args.stdout.strip() if args.returncode == 0 else ""


def collect_panes(session: str | None = None) -> list[dict]:
    fmt = "#{session_name}\t#{window_name}\t#{window_index}\t#{window_id}\t#{window_layout}\t#{pane_index}\t#{pane_id}\t#{pane_current_path}\t#{pane_pid}"
    args = ["list-panes", "-F", fmt]
    if session:
        args[1:1] = ["-s", "-t", session]
    else:
        args[1:1] = ["-a"]

    result = tmux(args, check=False)
    if result.returncode != 0:
        die(result.stderr.strip() or "tmux is not running")

    panes = []
    for line in result.stdout.splitlines():
        if not line:
            continue
        parts = line.split("\t")
        if len(parts) != 9:
            continue
        (
            session_name,
            window_name,
            window_index,
            window_id,
            window_layout,
            pane_index,
            pane_id,
            cwd,
            pane_pid,
        ) = parts
        panes.append(
            {
                "session": session_name,
                "window_name": window_name,
                "window_index": int(window_index),
                "window_id": window_id,
                "layout": window_layout,
                "pane_index": int(pane_index),
                "pane_id": pane_id,
                "cwd": cwd,
                "project": os.path.basename(cwd) if cwd else "",
                "command": pane_command(pane_pid),
            }
        )
    return panes


def read_workspace(path: Path) -> dict | None:
    try:
        with path.open(encoding="utf-8") as handle:
            data = yaml.safe_load(handle)
    except (OSError, yaml.YAMLError):
        return None
    if not isinstance(data, dict) or "workspace" not in data:
        return None
    data["windows"] = data.get("windows") or []
    return data


def load_workspace(path: Path) -> dict:
    data = read_workspace(path)
    if data is None:
        die(f"Invalid workspace file: {path}")
    return data


def workspace_stats(data: dict) -> tuple[int, int, list[str]]:
    windows = data.get("windows") or []
    names = [str(window.get("name") or "window") for window in windows]
    panes = sum(len(window.get("panes") or []) for window in windows)
    return len(windows), panes, names


def print_preview(path: Path, data: dict) -> None:
    windows, panes, names = workspace_stats(data)
    print()
    print(f"File:      {path}")
    print(f"Session:   {data.get('workspace')}")
    if data.get("source_session") and data.get("source_session") != data.get("workspace"):
        print(f"Exported:  {data.get('source_session')}")
    print(f"Windows:   {windows}")
    print(f"Panes:     {panes}")
    print()
    for window in data.get("windows") or []:
        wname = window.get("name") or "window"
        windex = window.get("index", "?")
        print(f"  {windex}:{wname}")
        for pane in window.get("panes") or []:
            command = pane.get("command") or "-"
            cwd = pane.get("cwd") or "?"
            print(f"    pane {pane.get('index', '?')}  {cwd}  {command}")
    print()


def saved_workspace_files() -> list[Path]:
    return sorted(workspaces_dir().glob("*.yaml"))


def print_catalog() -> list[tuple[Path, dict]]:
    files = saved_workspace_files()
    store = workspaces_dir()
    print()
    print(f"Saved workspaces ({store})")
    print()
    if not files:
        print("  (none yet)")
        print()
        print("Export the current session with:  tmux-manager export")
        print()
        return []

    loaded: list[tuple[Path, dict]] = []
    print(f"  {'#':<4} {'NAME':<22} {'WINDOWS':<9} {'PANES':<7} CONTAINS")
    print(f"  {'-':<4} {'----':<22} {'-------':<9} {'-----':<7} --------")
    for path in files:
        data = read_workspace(path)
        if data is None:
            print(f"       {path.stem:<22} {'?':<9} {'?':<7} (invalid file)")
            continue
        loaded.append((path, data))
        i = len(loaded)
        windows, panes, names = workspace_stats(data)
        contains = ", ".join(names) if names else "-"
        live = "  (running)" if session_exists(str(data.get("workspace"))) else ""
        print(
            f"  {i:<4} {data.get('workspace', path.stem):<22} {windows:<9} {panes:<7} {contains}{live}"
        )
    print()
    print("Restore one with:  tmux-manager restore NAME")
    print("Or pick a number below.")
    print()
    return loaded


def resolve_workspace_path(target: str) -> Path:
    raw = Path(target).expanduser()
    if raw.is_file():
        return raw

    store = workspaces_dir()
    candidates = [
        store / target,
        store / f"{target}.yaml",
        Path(f"{target}.yaml"),
        raw,
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate

    die(
        f"Workspace not found: {target}\n"
        f"Looked in {store}\n"
        "Run: tmux-manager restore"
    )
    raise AssertionError


def confirm(question: str) -> bool:
    if not sys.stdin.isatty():
        return True
    answer = input(f"{question} [y/N]: ").strip().lower()
    return answer in {"y", "yes"}


def cmd_ls(_args: argparse.Namespace) -> None:
    panes = collect_panes()
    if not panes:
        print("No tmux panes found.")
        return

    print()
    print(
        f"{'SESSION':<16} {'WINDOW':<22} {'PANE':<6} {'STATE':<8} {'PROJECT':<20} COMMAND"
    )
    print(
        f"{'-------':<16} {'------':<22} {'----':<6} {'-----':<8} {'-------':<20} -------"
    )

    for pane in panes:
        state = "run" if pane["command"] else "idle"
        command = pane["command"] or "-"
        window = f"{pane['window_index']}:{pane['window_name']}"
        print(
            f"{pane['session']:<16} {window:<22} {pane['pane_index']:<6} {state:<8} {pane['project']:<20} {command}"
        )
    print()


def resolve_session(requested: str | None) -> str:
    if requested:
        result = tmux(["has-session", "-t", requested], check=False)
        if result.returncode != 0:
            die(f"Session not found: {requested}")
        return requested
    if not os.environ.get("TMUX"):
        die("Not inside tmux. Pass a session with: tmux-manager export -t SESSION")
    return tmux_out(["display-message", "-p", "#S"])


def build_workspace(session: str, workspace_name: str) -> dict:
    panes = collect_panes(session)
    if not panes:
        die(f"No panes found in session: {session}")

    windows: OrderedDict[int, dict] = OrderedDict()
    for pane in panes:
        idx = pane["window_index"]
        if idx not in windows:
            windows[idx] = {
                "name": pane["window_name"],
                "index": idx,
                "layout": pane["layout"],
                "panes": [],
            }
        windows[idx]["panes"].append(
            {
                "index": pane["pane_index"],
                "cwd": pane["cwd"],
                "command": pane["command"],
            }
        )

    return {
        "workspace": workspace_name,
        "source_session": session,
        "windows": list(windows.values()),
    }


def cmd_export(args: argparse.Namespace) -> None:
    session = resolve_session(args.session)
    workspace_name = args.name or session
    data = build_workspace(session, workspace_name)

    if args.output:
        output = Path(args.output).expanduser()
    else:
        output = workspaces_dir() / f"{safe_filename(workspace_name)}.yaml"

    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="utf-8") as handle:
        yaml.safe_dump(
            data,
            handle,
            sort_keys=False,
            default_flow_style=False,
            allow_unicode=True,
        )

    windows, panes, names = workspace_stats(data)
    print(f"Saved '{session}' as {output}")
    print(f"{windows} windows, {panes} panes ({', '.join(names)})")
    print(f"Restore later with: tmux-manager restore {output.stem}")


def existing_cwd(cwd: str) -> str:
    if cwd and os.path.isdir(cwd):
        return cwd
    home = os.path.expanduser("~")
    print(f"warning: missing directory '{cwd}', using {home}", file=sys.stderr)
    return home


def pane_window_id(pane_id: str) -> str:
    return tmux_out(["display-message", "-p", "-t", pane_id, "#{window_id}"])


def send_command(pane_id: str, command: str) -> None:
    if not command.strip():
        return
    tmux(["send-keys", "-t", pane_id, command, "C-m"])


def session_exists(name: str) -> bool:
    return tmux(["has-session", "-t", name], check=False).returncode == 0


def choose_restore_session(preferred: str, as_name: str | None) -> str | None:
    session = as_name or preferred
    if not session_exists(session):
        return session

    print()
    print(f"Session '{session}' is already running.")
    print("The live session was not changed, replaced, or killed.")
    print()
    print(f"Attach it:           tmux attach -t {session}")
    print(f"Restore a copy:      tmux-manager restore {preferred} --as {preferred}-copy")
    print()

    if as_name:
        die("Refusing to overwrite a running session.")

    if not sys.stdin.isatty():
        die("Refusing to overwrite a running session.")

    copy = input("Restore as a different session name (empty cancels): ").strip()
    if not copy:
        print("Cancelled. Live session left running.")
        return None
    if session_exists(copy):
        die(f"Session '{copy}' is also already running. Live sessions were left untouched.")
    return copy


def restore_data(
    path: Path,
    data: dict,
    no_commands: bool,
    skip_confirm: bool,
    as_name: str | None = None,
) -> None:
    print_preview(path, data)
    session = choose_restore_session(str(data["workspace"]), as_name)
    if not session:
        return

    if not skip_confirm and not confirm(f"Restore as new session '{session}'?"):
        print("Cancelled.")
        return

    if session_exists(session):
        die(f"Session '{session}' appeared while confirming. Live session left untouched.")

    first_pane = True
    for window in data["windows"]:
        name = str(window.get("name") or "window")
        layout = window.get("layout") or ""
        window_id = None

        for pane_number, pane in enumerate(window.get("panes") or []):
            cwd = existing_cwd(str(pane.get("cwd") or ""))
            command = "" if no_commands else str(pane.get("command") or "")

            if first_pane:
                pane_id = tmux_out(
                    [
                        "new-session",
                        "-d",
                        "-s",
                        session,
                        "-n",
                        name,
                        "-c",
                        cwd,
                        "-P",
                        "-F",
                        "#{pane_id}",
                    ]
                )
                first_pane = False
            elif pane_number == 0:
                pane_id = tmux_out(
                    [
                        "new-window",
                        "-t",
                        session,
                        "-n",
                        name,
                        "-c",
                        cwd,
                        "-P",
                        "-F",
                        "#{pane_id}",
                    ]
                )
            else:
                if window_id is None:
                    die("Internal error: missing window id for split")
                pane_id = tmux_out(
                    [
                        "split-window",
                        "-t",
                        window_id,
                        "-c",
                        cwd,
                        "-P",
                        "-F",
                        "#{pane_id}",
                    ]
                )

            window_id = pane_window_id(pane_id)
            send_command(pane_id, command)

        if layout and window_id:
            tmux(["select-layout", "-t", window_id, layout], check=False)

    print(f"Restore complete: {session}")
    print(f"Attach with: tmux attach -t {session}")


def pick_from_catalog(entries: list[tuple[Path, dict]]) -> tuple[Path, dict] | None:
    if not sys.stdin.isatty():
        return None
    choice = input("Number or name (q to quit): ").strip()
    if not choice or choice.lower() in {"q", "quit"}:
        return None
    if choice.isdigit():
        index = int(choice)
        if 1 <= index <= len(entries):
            return entries[index - 1]
        print("No workspace with that number.")
        return None
    for path, data in entries:
        if path.stem == choice or str(data.get("workspace")) == choice:
            return path, data
    try:
        path = resolve_workspace_path(choice)
        return path, load_workspace(path)
    except SystemExit:
        return None


def cmd_restore(args: argparse.Namespace) -> None:
    if not args.target:
        entries = print_catalog()
        if not entries:
            return
        picked = pick_from_catalog(entries)
        if not picked:
            return
        path, data = picked
        restore_data(path, data, args.no_commands, args.yes, args.as_name)
        return

    path = resolve_workspace_path(args.target)
    data = load_workspace(path)
    restore_data(path, data, args.no_commands, args.yes, args.as_name)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tmux-manager",
        description="List, export, and restore tmux workspaces.",
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    ls_parser = sub.add_parser(
        "ls",
        aliases=["list"],
        help="List live tmux sessions, windows, and panes",
    )
    ls_parser.set_defaults(func=cmd_ls)

    export_parser = sub.add_parser(
        "export",
        help="Save the current (or -t) session into the workspaces folder",
    )
    export_parser.add_argument("-t", "--session", help="Session to export (default: current)")
    export_parser.add_argument("-n", "--name", help="Workspace name (default: session name)")
    export_parser.add_argument(
        "-o",
        "--output",
        help="Custom file path (default: workspaces/<name>.yaml)",
    )
    export_parser.set_defaults(func=cmd_export)

    restore_parser = sub.add_parser(
        "restore",
        help="Show saved workspaces, preview, then restore",
    )
    restore_parser.add_argument(
        "target",
        nargs="?",
        help="Workspace name or YAML path. Omit to list saved workspaces",
    )
    restore_parser.add_argument(
        "--no-commands",
        action="store_true",
        help="Recreate layout and directories only; do not send pane commands",
    )
    restore_parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Skip the confirmation prompt",
    )
    restore_parser.add_argument(
        "--as",
        dest="as_name",
        metavar="NAME",
        help="Create this session name instead (never overwrites a running session)",
    )
    restore_parser.set_defaults(func=cmd_restore)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
