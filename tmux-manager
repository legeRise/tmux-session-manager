    # Keep this hook last: prompt commands must not be mistaken for user input.
    case "$(declare -p PROMPT_COMMAND 2>/dev/null)" in
        "declare -a"*) PROMPT_COMMAND+=(__tmux_manager_precmd) ;;
        *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__tmux_manager_precmd" ;;
