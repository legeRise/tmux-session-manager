            command tmux set -p -u -t "$TMUX_PANE" @tm_command >/dev/null 2>&1
        fi
    }

    __tmux_manager_preexec() {
        if [ "${__tmux_manager_in_prompt-0}" != 1 ]; then
            return 0
        fi
        case $- in
            *i*) ;;
            *) return 0 ;;
        esac
        [ -n "${TMUX-}" ] && [ -n "${TMUX_PANE-}" ] || return 0
        case "$BASH_COMMAND" in
            __tmux_manager_precmd*|__tmux_manager_preexec*) return 0 ;;
            "command tmux set"*) return 0 ;;
        esac
        __tmux_manager_in_prompt=0
        local line
        line=$(HISTTIMEFORMAT= builtin history 1 2>/dev/null)
        if [[ $line =~ ^[[:space:]]*[0-9]+[[:space:]]+(.*)$ ]]; then
            line=${BASH_REMATCH[1]}
        else
